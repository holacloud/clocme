# Copy to .env (git-ignored) and adjust. All values are optional.

# Host port and host directory mounted as /data
PORT=7070
DATA_DIR=./data

# Container user: use your host uid/gid so data files stay yours (`id -u`, `id -g`)
UID=1000
GID=1000

# Public URL used in embed snippets, sitemap and canonical links
BASEURL=http://localhost:7070

# GitHub token: raises the API limit from 60 to 5000 requests/hour
GITHUBTOKEN=

# Telegram notifications for repos over the size limit
TELEGRAM_BOT=
TELEGRAM_CHAT=

MAXREPOSIZEMB=500
REFRESHMINUTES=60
WORKERS=1
# Repos listed and enqueued when visiting a user/organization page
MAXOWNERREPOS=300
