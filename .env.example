# Optional: docker-side settings only. Copy to .env (git-ignored).
# Application settings go in config.json (see config.example.json).

# Host port, and interface it listens on (0.0.0.0 to reach it from the LAN)
PORT=7070
LISTEN=127.0.0.1
# Host directory mounted as /data (clones, series, caches)
DATA_DIR=./data
# Host config file mounted as /app/config.json
CONFIG_FILE=./config.json
