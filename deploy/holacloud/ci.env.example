# CI settings for /containers/clocme/ci.sh. Copy to ci.env next to ci.sh.

# Public repo: plain https, no key needed.
REPO=https://github.com/holacloud/clocme.git
PRIVATE_KEY_FILE=
# Private repo: ssh url + read-only deploy key (see README).
#REPO=git@github.com:holacloud/clocme.git
#PRIVATE_KEY_FILE=/containers/clocme/deploy_key
BRANCH=master

# Service name (compose project, container and image). Defaults to the name
# of the directory of ci.sh, e.g. /containers/clocme -> clocme.
#SERVICE=clocme

# Telegram notifications (bot token without the "bot" prefix, and chat id)
TELEGRAM_BOT=
TELEGRAM_CHAT_ID=

# Host port Glue2 forwards cloc.hola.cloud to, and its interface. Check it is
# free with: ss -ltn 'sport = :7070'  (no output = free)
PORT=7070
LISTEN=127.0.0.1

# User the container runs as; data/ and config.json are chowned to it.
RUN_UID=1000
RUN_GID=1000
