# CI settings for /containers/clocme/ci.sh. Copy to ci.env next to ci.sh.

REPO=git@github.com:holacloud/clocme.git
BRANCH=master
# Read-only deploy key of the repo (GitHub > Settings > Deploy keys).
# Leave empty to use the default ssh identity of the user running cron.
PRIVATE_KEY_FILE=/containers/clocme/deploy_key

# Telegram notifications (bot token without the "bot" prefix, and chat id)
TELEGRAM_BOT=
TELEGRAM_CHAT_ID=

# Host port the reverse proxy forwards cloc.hola.cloud to, and its interface.
PORT=7070
LISTEN=127.0.0.1

# User the container runs as; data/ and config.json are chowned to it.
RUN_UID=1000
RUN_GID=1000
